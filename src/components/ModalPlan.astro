---
interface Props {
  id: string;
  title: string;
  price: string;
  currency?: string;
  features: string[];
  ctaText?: string;
  ctaLink?: string;
  lang?: 'es' | 'en';
}

const {
  id,
  title,
  price,
  currency = 'MXN',
  features,
  ctaText,
  ctaLink = 'https://wa.me/523342822799',
  lang = 'es'
} = Astro.props;

const inEnglish = lang === 'en';
---

<div
  id={id}
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  class="fixed inset-0 z-[100] hidden modal-backdrop modal-open p-4"
>
  <div
    data-modal-panel
    class="bg-white dark:bg-monokai-bg border border-gray-200 dark:border-white/10 rounded-2xl shadow-2xl max-w-lg w-full p-6 text-left relative"
  >
    <div class="flex items-center justify-between pb-3 border-b border-gray-200 dark:border-white/10">
      <h3 class="text-xl font-bold text-gray-900 dark:text-white">{title}</h3>
      <button
        data-modal-close
        aria-label={inEnglish ? "Close modal" : "Cerrar modal"}
        class="p-1 rounded-md text-gray-500 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 cursor-pointer"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="modal-body py-4 space-y-4 text-gray-700 dark:text-gray-300 text-sm">
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-extrabold text-gray-900 dark:text-white">{price}</span>
        <span class="text-sm font-semibold">{currency}</span>
      </div>

      <ul class="space-y-2.5 list-disc list-inside">
        {features.map((feat) => (
          <li>{feat}</li>
        ))}
      </ul>
    </div>

    <div class="pt-4 border-t border-gray-200 dark:border-white/10 flex items-center justify-end gap-3">
      <button
        data-modal-close
        class="px-4 py-2 text-sm font-semibold rounded-lg border border-gray-300 dark:border-white/20 hover:bg-gray-50 dark:hover:bg-white/10 cursor-pointer"
      >
        {inEnglish ? 'Close' : 'Cerrar'}
      </button>
      <a
        href={ctaLink}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 text-sm font-semibold rounded-lg bg-brand-cyan text-white hover:opacity-90 transition-opacity"
      >
        {ctaText || (inEnglish ? 'Inquire now' : 'Solicitar plan')}
      </a>
    </div>
  </div>
</div>

<script>
  function setupModals() {
    const openers = document.querySelectorAll('[data-modal-target]');

    function openModal(modal: HTMLElement | null) {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('modal-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');

      const closeHandler = (e: KeyboardEvent) => {
        if (e.key === 'Escape') closeModal(modal);
      };
      (modal as any)._onKey = closeHandler;
      document.addEventListener('keydown', closeHandler);
    }

    function closeModal(modal: HTMLElement | null) {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('modal-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
      if ((modal as any)._onKey) {
        document.removeEventListener('keydown', (modal as any)._onKey);
      }
    }

    openers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const sel = btn.getAttribute('data-modal-target');
        const modal = sel ? document.querySelector<HTMLElement>(sel) : null;
        openModal(modal);
      });
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const closeBtn = target.closest('[data-modal-close]');
      if (closeBtn) {
        const modal = closeBtn.closest<HTMLElement>('[role="dialog"]');
        closeModal(modal);
      }
      if (target.getAttribute && target.getAttribute('role') === 'dialog') {
        closeModal(target);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupModals);
  } else {
    setupModals();
  }
</script>
